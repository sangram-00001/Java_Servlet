<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ===================== -->
    <!-- Servlet Configuration -->
    <!-- ===================== -->

    <servlet>
        <servlet-name>NameServlet</servlet-name>
        <servlet-class>com.pack.NameServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>NameServlet</servlet-name>
        <url-pattern>/name</url-pattern>
    </servlet-mapping>


    <!-- ===================== -->
    <!-- Filter Configuration -->
    <!-- ===================== -->

    <filter>
        <filter-name>NameFilter</filter-name>
        <filter-class>com.pack.NameFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>NameFilter</filter-name>
        <url-pattern>/name</url-pattern>
    </filter-mapping>


    <!-- ===================== -->
    <!-- Listener Configuration -->
    <!-- ===================== -->

    <listener>
        <listener-class>com.pack.MyListener</listener-class>
    </listener>

</web-app>